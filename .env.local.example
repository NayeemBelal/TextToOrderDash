# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Service role key for server-side operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Sales AI: show the reasoning trace in the dashboard collapsible.
# Default (unset or "0") hides it — the trace is still captured server-side
# for logging + night-dreaming consolidation. Set to "1" for internal debugging.
NEXT_PUBLIC_SHOW_THINKING=0
